{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "python3 scripts/build.py",
  "outputDirectory": "_site",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.oshodiscourses.com"
        }
      ],
      "destination": "https://oshodiscourses.com/:path*",
      "permanent": true
    }
  ]
}
