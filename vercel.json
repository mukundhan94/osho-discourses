{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix web ci",
  "buildCommand": "node -v && npm --prefix web run build",
  "outputDirectory": "web/dist",
  "trailingSlash": true,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/year/:id/index.html", "destination": "/year/:id/", "permanent": true },
    { "source": "/series/:slug/index.html", "destination": "/series/:slug/", "permanent": true }
  ]
}
