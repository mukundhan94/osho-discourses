---
// One year on its own address: the same section the home page shows, with its own head.
import { YearPage } from "../../components/YearPage.tsx";
import type { Year } from "../../data/index.ts";
import Page from "../../layouts/Page.astro";
import { getBuild } from "../../lib/build.ts";
import { clip, ldText, SITE, yearTitle, yearUrl } from "../../lib/site.ts";

export function getStaticPaths() {
  return getBuild().site.years.map((year) => ({ params: { id: year.id } }));
}

const { site, outlines, seriesUrls } = getBuild();
const year = site.years.find((y) => y.id === Astro.params.id) as Year;
const url = SITE + yearUrl(year);
const title = yearTitle(year);
const description = clip(year.lede);
const parts = site.series.filter((x) => x.years.includes(year)).map((x) => ({ "@id": `${SITE}series/${x.slug}/` }));
const ld = ldText({
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": url,
  url,
  name: title,
  description,
  inLanguage: "en",
  isPartOf: { "@id": `${SITE}#website` },
  ...(parts.length ? { hasPart: parts } : {}),
});
---
<Page title={title} description={description} canonical={url} ld={ld} root="/" extraCss={["pages.css"]} script="band">
<YearPage site={site} year={year} outlines={outlines} seriesUrls={seriesUrls} />
</Page>
