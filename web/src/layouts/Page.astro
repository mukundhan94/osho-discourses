---
// The document every page shares: the head tags, and the scripts at the end of the body.
import { assetVersion, OG_IMAGE, OG_IMAGE_ALT, OG_SIZE, SITE } from "../lib/site.ts";

interface Props {
  title: string;
  description: string;
  /** The page's one public address. */
  canonical: string;
  /** The description social cards show, when it differs from the one for search. */
  ogDescription?: string;
  /** Structured data, as the text of a script element. */
  ld: string;
  /** "" on the home page, "/" on pages in folders: the start of every asset address. */
  root: string;
  /** Stylesheets in assets/ to load after site.css. */
  extraCss?: string[];
  /** The script before the analytics snippet: the home page's own, or the one that centres the year band. */
  script: "home" | "band";
}
const { title, description, ogDescription = description, canonical, ld, root, extraCss = [], script } = Astro.props;

const ICON =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%231F3A6B'/%3E%3Ccircle cx='16' cy='16' r='10' fill='%23E9A21A'/%3E%3Ccircle cx='16' cy='16' r='5' fill='%23C2281D'/%3E%3C/svg%3E";

// Kept word for word from scripts/build.py. BAND centres the current year in the band;
// ANALYTICS is Vercel's snippet. The home page loads assets/site.js instead of BAND.
const BAND = `<script>(function () {
  var here = document.querySelector('.years [aria-current]');
  if (here) here.parentNode.scrollLeft = here.offsetLeft - (here.parentNode.clientWidth - here.offsetWidth) / 2;
})();</script>`;
const HOME = `<script src="assets/site.js?v=${assetVersion("site.js")}" defer></script>`;
const ANALYTICS = `<script>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
window.si = window.si || function () { (window.siq = window.siq || []).push(arguments); };</script>
<script defer src="/_vercel/insights/script.js"></script>
<script defer src="/_vercel/speed-insights/script.js"></script>
`;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:url" content={canonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={ogDescription}>
<meta property="og:type" content="website">
<meta property="og:image" content={`${SITE}${OG_IMAGE}?v=${assetVersion(OG_IMAGE.slice("assets/".length))}`}>
<meta property="og:image:width" content={String(OG_SIZE.width)}>
<meta property="og:image:height" content={String(OG_SIZE.height)}>
<meta property="og:image:alt" content={OG_IMAGE_ALT}>
<meta name="twitter:card" content="summary_large_image">
<script type="application/ld+json" set:html={ld}></script>
<meta name="theme-color" content="#1F3A6B">
<link rel="icon" href={ICON}>
<link rel="preload" href={`${root}assets/fonts/yatra-one-latin-400.woff2`} as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href={`${root}assets/site.css?v=${assetVersion("site.css")}`}>
{extraCss.map((name) => <link rel="stylesheet" href={`${root}assets/${name}?v=${assetVersion(name)}`}>)}
</head>
<body>
<slot />
<Fragment set:html={(script === "home" ? HOME : BAND) + "\n" + ANALYTICS} />
</body>
</html>
